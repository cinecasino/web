# ── Modo pages (por defecto: npm run dev / npm run build) ─────────────────────
# Web estática para GitHub Pages. Rellena UNA de las dos:
#
# Recomendado: la URL del Worker de Cloudflare (carpeta worker/), que guarda el token en secreto.
# Admite peticiones desde http://localhost:4321, así que también vale para desarrollar.
# PUBLIC_TMDB_PROXY=https://cinecasino.<tu-subdominio>.workers.dev
#
# Sin Worker: el navegador llama a TMDB directamente con este token.
# ⚠️ Este token ACABA EN EL JAVASCRIPT PÚBLICO. Usa un token de lectura (v4) de
#    https://www.themoviedb.org/settings/api y regenéralo si ves abusos.
PUBLIC_TMDB_TOKEN=

# ── Modo server (npm run dev:server / npm run build:server + npm start) ───────
# Cuentas, partida en la nube, panel /admin y proxy de TMDB. Estas variables NUNCA llegan al navegador.
TMDB_TOKEN=
# TMDB_API_KEY=

# Base de datos libSQL: archivo local en desarrollo, Turso en producción
DATABASE_URL=file:data/casino.db
# DATABASE_URL=libsql://tu-base.turso.io
# DATABASE_AUTH_TOKEN=

# Emails que serán administradores al registrarse o entrar (separados por comas)
ADMIN_EMAILS=tu@email.com
