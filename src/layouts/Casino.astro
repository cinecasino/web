---
import '@fontsource/bungee';
import '@fontsource/bungee-shade';
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/600.css';
import '@fontsource/rubik/800.css';
import '../styles/global.css';
import { ACCOUNTS, issuesUrl, SITE, u } from '../site';
import { existsSync } from 'node:fs';

// El logo oficial de TMDB hay que descargarlo a mano (ver README); si no está, solo se muestra el texto.
const hasTmdbLogo = existsSync('public/brand/tmdb.svg');

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** game: HUD de fichas, menú de juegos y ticker. page: cabecera sencilla (landing, legales, cuenta, admin). */
  variant?: 'game' | 'page';
}
const { title, description = SITE.description, active = '', variant = 'game' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const issues = issuesUrl();

const nav = [
  { href: u(), label: 'Lobby', icon: '🏛️', key: 'lobby' },
  { href: u('tragaperras'), label: 'Tragaperras', icon: '🎰', key: 'slots' },
  { href: u('ruleta'), label: 'Ruleta', icon: '🎡', key: 'ruleta' },
  { href: u('cajas'), label: 'Cajas', icon: '🎁', key: 'cajas' },
  { href: u('rasca'), label: 'Rasca', icon: '🎟️', key: 'rasca' },
  { href: u('mayor-menor'), label: '¿Más o Menos?', icon: '🃏', key: 'hilo' },
  { href: u('botin'), label: 'Mi Botín', icon: '💰', key: 'botin' },
  { href: u('logros'), label: 'Logros', icon: '🏆', key: 'logros' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0512" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(u('icons/icon-512.png'), Astro.site ?? 'http://localhost').href} />
    <link rel="manifest" href={u('manifest.webmanifest')} />
    <link rel="icon" type="image/png" sizes="32x32" href={u('icons/favicon-32.png')} />
    <link rel="apple-touch-icon" href={u('icons/apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body class={`v-${variant}`}>
    <div class="bg-lights" aria-hidden="true"></div>
    <div class="bg-floaters" id="floaters" aria-hidden="true"></div>

    {
      variant === 'game' ? (
        <>
          <header class="topbar">
            <a href={u('')} class="logo">
              <span class="logo-icon">🎰</span>
              <span class="neon-pink">{SITE.logo[0]}</span>
              <span class="neon-gold">{SITE.logo[1]}</span>
              {SITE.stage && <span class="stage-tag">{SITE.stage}</span>}
            </a>
            <div class="hud">
              <div class="hud-coins" id="hud-coins" title="Fichas">
                <span class="coin-icon">🪙</span>
                <b id="coins-val">0</b>
              </div>
              <div class="hud-level" title="Nivel">
                <span class="lvl" id="lvl-val">1</span>
                <div class="xp-wrap">
                  <div class="xpbar">
                    <i id="xp-fill" />
                  </div>
                  <small id="xp-text" />
                </div>
              </div>
              <button id="hud-daily" class="chip daily" title="Bonus diario">🎁 Diario</button>
              <button id="hud-rescue" class="chip rescue" hidden>🆘 Rescate</button>
              <button id="hud-mode" class="chip" title="Películas, series o ambas">🎬 Pelis</button>
              <button id="hud-mute" class="chip" title="Sonido">🔊</button>
              <button class="chip install-chip" data-install hidden title="Instalar como app">📲 Instalar</button>
              {ACCOUNTS && <span class="user-slot" data-user-slot />}
            </div>
          </header>
          <nav class="nav">
            {nav.map((n) => (
              <a href={n.href} class:list={[{ active: n.key === active }]}>
                <span>{n.icon}</span>
                {n.label}
              </a>
            ))}
          </nav>
        </>
      ) : (
        <header class="topbar page-top">
          <a href={u('')} class="logo">
            <span class="logo-icon">🎰</span>
            <span class="neon-pink">{SITE.logo[0]}</span>
            <span class="neon-gold">{SITE.logo[1]}</span>
            {SITE.stage && <span class="stage-tag">{SITE.stage}</span>}
          </a>
          <div class="hud">
            <a class="chip" href={u('landing')}>ℹ️ Qué es</a>
            <button class="chip install-chip" data-install hidden>📲 Instalar</button>
            {ACCOUNTS && <span class="user-slot" data-user-slot />}
            <a class="btn btn-gold enter-btn" href={u('')}>🎰 Entrar al casino</a>
          </div>
        </header>
      )
    }

    <div id="announce" class="announce" hidden></div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="sf-row">
        <span class="sf-brand">🎰 {SITE.name} · <b>sin dinero real</b>: las fichas no se compran ni se canjean</span>
        <nav class="sf-links">
          <a href={u('landing')}>Qué es</a>
          <a href={u('privacidad')}>Privacidad</a>
          <a href={u('cookies')}>Cookies</a>
          <button type="button" data-cookie-prefs>Preferencias de cookies</button>
          {ACCOUNTS && <a href={u('cuenta')}>Mi cuenta</a>}
          {issues && <a href={issues} target="_blank" rel="noopener">🐞 Reportar un problema</a>}
          <span class="sf-version" title="Versión">v{SITE.version}</span>
        </nav>
      </div>
      <div class="sf-tmdb">
        {hasTmdbLogo && <img src={u('brand/tmdb.svg')} alt="TMDB" width="110" height="14" />}
        <span>Este producto usa la API de TMDB, pero TMDB no lo respalda ni lo certifica. Datos de plataformas: JustWatch.</span>
      </div>
    </footer>

    {
      variant === 'game' && (
        <footer class="ticker">
          <div class="ticker-track" id="ticker">
            <div class="ticker-run">🎰 Cargando lo más caliente de la semana…</div>
          </div>
        </footer>
      )
    }

    <dialog id="modal" class="modal"><div class="modal-inner"></div></dialog>
    <div id="toasts" class="toasts"></div>
    <div id="fx-layer" class="fx-layer" aria-hidden="true"></div>

    <script>
      import '../lib/site';
    </script>
  </body>
</html>
