---
import Casino from '../layouts/Casino.astro';
import Wheel from '../components/Wheel.astro';
import { symbol } from '../lib/genres';
import type { WheelSeg } from '../lib/wheel';

const genre = (key: string): WheelSeg => {
  const s = symbol(key);
  return { kind: 'genre', key, emoji: s.emoji, name: s.short ?? s.name, color: '', movie: [s.movie], tv: [s.tv] };
};
const segs: WheelSeg[] = [
  genre('accion'), genre('comedia'), genre('terror'),
  { kind: 'mult', key: 'x2', emoji: '💸', name: 'x2', color: '#0f8a4a', mult: 2 },
  genre('scifi'), genre('drama'), genre('crimen'),
  { kind: 'quiebra', key: 'quiebra', emoji: '💀', name: 'QUIEBRA', color: '#050308' },
  genre('animacion'), genre('fantasia'), genre('misterio'),
  { kind: 'jackpot', key: 'jackpot', emoji: '💎', name: 'JACKPOT', color: '#e6a700' },
  genre('aventura'), genre('romance'),
];
let g = 0;
for (const s of segs) if (s.kind === 'genre') s.color = g++ % 2 ? '#1b1030' : '#c8102e';
segs[segs.length - 1].color = '#5b1a8f';
---

<Casino title="Ruleta" active="ruleta">
  <section class="wheel-page">
    <Wheel segs={segs} cost={30} label="🎡 ¡GIRAR!" />

    <aside class="side-panel">
      <h3>📜 Reglas de la casa</h3>
      <ul class="paytable">
        <li><span>🎭 Género</span><b>te toca un título de ese género</b></li>
        <li><span>💸 x2</span><b>+60 🪙 y giro gratis</b></li>
        <li><span>💎 JACKPOT</span><b>+400 🪙 y un título top</b></li>
        <li><span>💀 QUIEBRA</span><b>la casa gana</b></li>
      </ul>
      <h3>🕘 Lo que ha caído</h3>
      <div class="history" id="history"><p class="muted small">La rueda espera…</p></div>
    </aside>
  </section>
</Casino>

<script>
  import { initWheel } from '../lib/wheel';
  import { onPage } from '../lib/page';

  // (la Ruleta del Terror también tiene #wheel: esta es la que no es de temporada)
  onPage('section.wheel-page:not([data-event])', () => {
    initWheel({
      cost: 30,
      jackpotCoins: 400,
      jackpot: { minVote: 8, minVotes: 1000 },
      spinLabel: '🎡 ¡GIRAR!',
      jackpotHeadline: '💎 JACKPOT de la ruleta',
      genreHeadline: (seg) => `🎡 La ruleta dice: ${seg.emoji} ${seg.name}`,
    });
  });
</script>
